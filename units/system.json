{
  "id": "syscheck-unit-definition",
  "version": "0.1",
  "viewType": "SYSTEM",
  "viewParameters": {
    "browser": {
      "enabled": true,
      "limits": [
        {
          "browser": "chrome",
          "minVersion": "143"
        },
        {
          "browser": "safari",
          "minVersion": "145",
          "message": "min required version: 145"
        }
      ]
    },
    "os": {
      "enabled": true,
      "limits": [
        {
          "os": "windows",
          "minVersion": "10"
        },
        {
          "os": "ios",
          "minVersion": "15"
        },
        {
          "os": "android",
          "minVersion": "12"
        },
        {
          "os": "macos",
          "minVersion": "12"
        },
        {
          "os": "linux"
        }
      ]
    },
    "resolution": {
      "enabled": true,
      "limits": [
        {
          "width": 1200,
          "height": 800
        }
      ]
    }
  },
  "messages": {
    "success": "Your system is good.",
    "error": "Your system is not supported.",
    "os_not_supported": "Your OS is not supported.",
    "browser_not_supported": "Your browser is not supported.",
    "resolution_not_supported": "Your screen resolution is not supported.",
    "os_version_not_supported": "Your OS version is not supported.",
    "browser_version_not_supported": "Your browser version is not supported."
  }
}
